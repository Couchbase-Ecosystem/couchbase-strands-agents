{
  "name": "@couchbase-ecosystem/strands-couchbase",
  "version": "0.1.1",
  "description": "Couchbase Hyperscale Vector Search MemoryStore extension for Strands Agents",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test examples",
    "format": "prettier --write src test examples",
    "format:check": "prettier --check src test examples",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && node scripts/check-readme.mjs",
    "readme:sync": "node scripts/check-readme.mjs --write",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test && npm run build",
    "example:setup": "tsx --tsconfig tsconfig.test.json --env-file=.env examples/setup.ts",
    "example:quickstart": "tsx --tsconfig tsconfig.test.json --env-file=.env examples/quickstart.ts",
    "example:smoke": "tsx --tsconfig tsconfig.test.json --env-file=.env examples/smoke-test.ts",
    "test:live": "vitest run test/integration-live.test.ts test/initialize-live.test.ts",
    "smoke:package": "bash scripts/smoke-test-package.sh"
  },
  "keywords": [
    "strands",
    "agents",
    "couchbase",
    "vector-search",
    "memory-store"
  ],
  "author": "Couchbase Ecosystem <devadvocacy@couchbase.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Couchbase-Ecosystem/couchbase-strands-agents.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Couchbase-Ecosystem/couchbase-strands-agents/issues"
  },
  "homepage": "https://github.com/Couchbase-Ecosystem/couchbase-strands-agents/tree/main/typescript#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@strands-agents/sdk": ">=1.13.0 <2.0.0"
  },
  "dependencies": {
    "couchbase": "^4.7.1"
  },
  "devDependencies": {
    "@strands-agents/sdk": "^1.19.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.0.0",
    "openai": "^6.49.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
