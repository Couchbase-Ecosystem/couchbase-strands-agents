# Copy to .env and edit. Python doesn't read .env by itself: export it into your shell first with
#   set -a; source .env; set +a
COUCHBASE_CONNECTION_STRING=couchbase://localhost
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=strands_memory
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION=_default
COUCHBASE_VECTOR_BACKEND=hyperscale
# Must match the vector index similarity. examples/setup.py creates the index with it.
COUCHBASE_DISTANCE_METRIC=COSINE
# Only needed when COUCHBASE_VECTOR_BACKEND=search
COUCHBASE_SEARCH_INDEX=strands-memory-search-index
COUCHBASE_NAMESPACE=default

# Used by examples/quickstart.py for both the chat model and the embeddings.
OPENAI_API_KEY=
# Size of your embedding vectors; examples/setup.py creates the vector index with it.
# text-embedding-3-small: 1536, Bedrock Titan v2: 1024, all-MiniLM-L6-v2: 384.
EMBEDDING_DIMENSIONS=1536

# Set to 1 to run the live tests (needs a 3-dimension vector index; see README).
COUCHBASE_INTEGRATION_TESTS=0
